<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.6//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_6.dtd'>
<nta>
	<declaration>  broadcast chan route_order;
  broadcast chan merge;
  broadcast chan resume;</declaration>
	<template>
		<name>LT</name>
		<location id="id0" x="50" y="50">
			<name x="25" y="8">Driving</name>
		</location>
		<init ref="id0"/>
	</template>
	<template>
		<name>MT</name>
		<location id="id1" x="200" y="50">
			<name x="119" y="34">Driving</name>
		</location>
		<location id="id2" x="400" y="50">
			<name x="433" y="34">Slow</name>
		</location>
		<init ref="id1"/>
		<transition id="id3">
			<source ref="id1"/>
			<target ref="id2"/>
			<label kind="synchronisation" x="255" y="25">route_order?</label>
		</transition>
		<transition id="id4">
			<source ref="id2"/>
			<target ref="id1"/>
			<label kind="synchronisation" x="272" y="59">resume?</label>
		</transition>
	</template>
	<template>
		<name>MG</name>
		<location id="id5" x="200" y="200">
			<name x="161" y="59">Driving</name>
		</location>
		<location id="id6" x="400" y="200">
			<name x="382" y="170">Switch</name>
		</location>
		<branchpoint id="id7" x="195" y="195"/>
		<init ref="id5"/>
		<transition id="id8">
			<source ref="id5"/>
			<target ref="id5"/>
			<nail x="255" y="93"/>
			<nail x="127" y="93"/>
		</transition>
		<transition id="id9">
			<source ref="id5"/>
			<target ref="id6"/>
			<label kind="synchronisation" x="255" y="178">route_order?</label>
		</transition>
		<transition id="id10">
			<source ref="id5"/>
			<target ref="id6"/>
			<label kind="synchronisation" x="272" y="204">merge?</label>
		</transition>
		<transition id="id11">
			<source ref="id6"/>
			<target ref="id5"/>
			<label kind="synchronisation" x="263" y="221">resume?</label>
		</transition>
	</template>
	<template>
		<name>Env</name>
		<declaration>
      clock t;
    </declaration>
		<location id="id12" x="85" y="348">
			<name x="52" y="304">Normal</name>
		</location>
		<location id="id13" x="229" y="178">
			<name x="178" y="136">Reordering</name>
		</location>
		<location id="id14" x="348" y="348">
			<name x="357" y="357">SwitchCmd</name>
		</location>
		<init ref="id12"/>
		<transition id="id15">
			<source ref="id12"/>
			<target ref="id13"/>
			<label kind="guard" x="102" y="238">t &gt;= 3</label>
			<label kind="synchronisation" x="51" y="263">route_order!</label>
			<label kind="assignment" x="93" y="212">t := 0</label>
		</transition>
		<transition id="id16">
			<source ref="id13"/>
			<target ref="id14"/>
			<label kind="guard" x="323" y="255">t &gt;= 1</label>
			<label kind="synchronisation" x="331" y="280">merge!</label>
			<label kind="assignment" x="348" y="306">t := 0</label>
		</transition>
		<transition id="id17">
			<source ref="id14"/>
			<target ref="id12"/>
			<label kind="guard" x="238" y="357">t &gt;= 1</label>
			<label kind="synchronisation" x="238" y="374">resume!</label>
			<label kind="assignment" x="238" y="391">t := 0</label>
		</transition>
	</template>
	<system>  env = Env();  
  lt  = LT();   
  mt  = MT();   
  mg  = MG();   
  system env, lt, mt, mg;
</system>
	<queries>
		<query>
			<formula/>
			<comment>A [ ] not deadlock</comment>
		</query>
		<query>
			<formula/>
			<comment/>
		</query>
	</queries>
</nta>
